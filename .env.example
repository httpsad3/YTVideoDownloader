# Límites de uso (todos opcionales, tienen valores por defecto razonables)
MAX_VIDEO_DURATION_MINUTES=20
RATE_LIMIT_MAX_REQUESTS=8
RATE_LIMIT_WINDOW_MINUTES=10
MP3_BITRATE_KBPS=192

# OBLIGATORIO para build y runtime (Vercel y local): fuerza a youtube-dl-exec
# a descargar el binario standalone de yt-dlp (sin dependencia de python3).
# Ver README.md, sección "yt-dlp en Vercel", antes de desplegar.
YOUTUBE_DL_FILENAME=yt-dlp_linux
